cabal-version:   3.0
name:            stockfischer
version:         0.1.0.0
synopsis:        A chess CLI with an alpha-beta pruning engine.
description:
  A chess command-line interface that allows you to play against another human, against the
  computer, or even have the computer play against itself. The computer engine implements the
  minimax algorithm with alpha-beta pruning.
license:         Unlicense
author:          Rafael Ritter
maintainer:      rafaritter44@hotmail.com
category:        Game
build-type:      Simple
extra-doc-files: README.md

common deps
  build-depends:    base ^>=4.18.3.0, containers ^>=0.8
  default-language: Haskell2010
  ghc-options:      -Wall

library
  import:         deps
  exposed-modules:
    Stockfischer.AI
    Stockfischer.Rules
    Stockfischer.Board
    Stockfischer.Moves
    Stockfischer.Players
  build-depends:  matrix ^>=0.3.6.4
  hs-source-dirs: src

executable stockfischer
  import:         deps
  main-is:        Main.hs
  other-modules:  Stockfischer.Game
  build-depends:  stockfischer
  hs-source-dirs: app

test-suite stockfischer-test
  import:             deps
  type:               exitcode-stdio-1.0
  main-is:            Spec.hs
  build-depends:      stockfischer, hspec ^>=2.11.18
  build-tool-depends: hspec-discover:hspec-discover ^>=2.11.18
  hs-source-dirs:     test
