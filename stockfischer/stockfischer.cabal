cabal-version:   3.0
name:            stockfischer
version:         0.1.0.0
synopsis:        A chess CLI with an alpha-beta pruning engine.
description:
  A chess command-line interface that allows you to play against another human, against the
  computer, or even have the computer play against itself. The computer engine implements the
  minimax algorithm with alpha-beta pruning.
license:         Unlicense
author:          Rafael Ritter
maintainer:      rafaritter44@hotmail.com
category:        Game
build-type:      Simple
extra-doc-files: README.md

common warnings
  ghc-options: -Wall

library
  import:           warnings
  exposed-modules:
    Stockfischer.AI
    Stockfischer.Rules
    Stockfischer.Board
    Stockfischer.Players
  other-modules:    Stockfischer.Moves
  build-depends:
    base       ^>=4.18.3.0,
    containers ^>=0.8,
    matrix     ^>=0.3.6.4
  hs-source-dirs:   src
  default-language: Haskell2010

executable stockfischer
  import:           warnings
  main-is:          Main.hs
  other-modules:    Stockfischer.Game
  build-depends:
    stockfischer,
    base       ^>=4.18.3.0,
    containers ^>=0.8
  hs-source-dirs:   app
  default-language: Haskell2010

test-suite stockfischer-test
  type:             exitcode-stdio-1.0
  import:           warnings
  main-is:          Main.hs
  -- other-modules:
  build-depends:
    stockfischer,
    base ^>=4.18.3.0
  hs-source-dirs:   test
  default-language: Haskell2010
